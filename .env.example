# ==================================================
# AI 提案协助 - 环境变量样例
# 复制此文件为 .env 并填入真实值
# ==================================================

# OpenAI / OpenAI 兼容 API
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# 应用数据目录（可选；不设则使用系统默认）
# macOS:   ~/Library/Application Support/ai-presales
# Windows: %APPDATA%/ai-presales
# Linux:   ~/.local/share/ai-presales
APP_DATA_DIR=

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 开发模式: 1 启用 vite dev server，0 使用构建产物
DEV_MODE=0
