{
  "name": "ai-presales",
  "version": "0.1.0",
  "description": "AI 提案协助桌面应用",
  "license": "UNLICENSED",
  "nodeModulesDir": "auto",

  "tasks": {
    "dev": "deno run -A --watch dev.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "deno run -A --watch dev.ts",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build:mac": "deno desktop -A --no-check --target aarch64-apple-darwin -o dist/ai-presales-mac main.ts && ./scripts/post-build-mac.sh dist/ai-presales-mac.app",
    "build:mac-x64": "deno desktop -A --no-check --target x86_64-apple-darwin -o dist/ai-presales-mac-x64 main.ts && ./scripts/post-build-mac.sh dist/ai-presales-mac-x64.app",
    "build:linux": "deno desktop -A --no-check -o dist/ai-presales main.ts",
    "serve:dist": "deno run -A main.ts",
    "start": "deno task build:frontend && deno task serve:dist",
    "test": "deno test -A tests/",
    "test:unit": "deno test -A tests/unit/",
    "test:integration": "deno test -A tests/integration/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check **/*.ts **/*.vue",
    "fetch:extensions": "deno run -A scripts/fetch-extensions.ts"
  },

  "imports": {
    "node:sqlite": "node:sqlite",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/log": "jsr:@std/log@^0.224.0",
    "@std/uuid": "jsr:@std/uuid@^1.0.0",
    "@std/toml": "jsr:@std/toml@^1.0.0",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.38.0",
    "@openai/openai": "npm:openai@^4.85.0",
    "@types/node": "npm:@types/node@^22.0.0",
    "exceljs": "npm:exceljs@^4.4.0",
    "zod": "npm:zod@^3.23.0",
    "@/": "./",
    "@shared/": "./shared/",
    "@backend/": "./backend/",
    "@frontend/": "./frontend/src/"
  },

  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable", "esnext"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": true,
    "jsx": "preserve",
    "jsxImportSource": "vue"
  },

  "desktop": {
    "backend": "webview"
  },

  "lint": {
    "include": ["backend/", "shared/", "scripts/", "tests/", "main.ts", "dev.ts"],
    "exclude": ["dist/", "frontend/node_modules/", "frontend/dist/", "**/*.vue", "**/*.d.ts"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },

  "fmt": {
    "include": ["backend/", "shared/", "scripts/", "tests/", "main.ts", "dev.ts"],
    "exclude": ["dist/", "frontend/node_modules/", "frontend/dist/", "**/*.vue", "**/*.d.ts", "deno.lock"],
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "proseWrap": "preserve"
  },

  "exclude": [
    "dist/",
    "frontend/node_modules/",
    "frontend/dist/",
    "**/*.vue"
  ]
}
